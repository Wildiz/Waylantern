{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "name",
    "url",
    "category",
    "price",
    "level",
    "languages",
    "structure",
    "focus_friendly",
    "description",
    "verified",
    "areas"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "pattern": "^https://"
    },
    "repository": {
      "type": "string",
      "pattern": "^https://(github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+|gitlab\\.com/[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)+)/?$"
    },
    "prerequisites": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "category": {
      "enum": [
        "path",
        "course",
        "practice",
        "reference",
        "roadmap",
        "tool",
        "community"
      ]
    },
    "price": {
      "enum": [
        "free",
        "freemium",
        "paid-cheap",
        "paid",
        "unverified"
      ]
    },
    "level": {
      "enum": [
        "beginner",
        "intermediate",
        "advanced",
        "all"
      ]
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2}$"
      }
    },
    "structure": {
      "enum": [
        "guided",
        "semi",
        "self-directed"
      ]
    },
    "focus_friendly": {
      "enum": [
        "high",
        "medium",
        "low",
        "unknown"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 10
    },
    "pros": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verified": {
      "type": "object",
      "required": [
        "date",
        "method"
      ],
      "additionalProperties": false,
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "method": {
          "enum": [
            "official-site",
            "github-repo",
            "search-only"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "areas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "cs",
          "web",
          "networking",
          "architecture",
          "testing",
          "embedded",
          "design-product",
          "software",
          "data",
          "ai",
          "devops",
          "it-support",
          "security",
          "math",
          "games-mobile",
          "career",
          "study-skills",
          "focus",
          "general"
        ]
      }
    }
  }
}
