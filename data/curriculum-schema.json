{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["group", "curricula"],
  "additionalProperties": false,
  "properties": {
    "group": {"$ref": "#/$defs/id"},
    "curricula": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/curriculum"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "texts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
    "stage": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "topics", "resources", "practice", "checkpoint"],
      "properties": {
        "title": {"$ref": "#/$defs/text"},
        "topics": {"type": "array", "minItems": 2, "maxItems": 4, "items": {"$ref": "#/$defs/text"}},
        "resources": {"type": "array", "maxItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "practice": {"$ref": "#/$defs/text"},
        "checkpoint": {"$ref": "#/$defs/text"},
        "gap": {"$ref": "#/$defs/text"}
      },
      "allOf": [{"if": {"properties": {"resources": {"maxItems": 0}}}, "then": {"required": ["gap"]}}]
    },
    "curriculum": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "title", "summary", "entry_level", "prerequisites", "outcome", "stages", "next_steps"],
      "properties": {
        "role": {"$ref": "#/$defs/id"}, "title": {"$ref": "#/$defs/text"}, "summary": {"$ref": "#/$defs/text"},
        "entry_level": {"enum": ["from-zero", "after-basics", "experience-required"]},
        "prerequisites": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/text"}},
        "outcome": {"$ref": "#/$defs/text"},
        "stages": {"type": "array", "minItems": 4, "maxItems": 6, "items": {"$ref": "#/$defs/stage"}},
        "next_steps": {"$ref": "#/$defs/text"}
      }
    }
  }
}
